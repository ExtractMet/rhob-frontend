# rhob-frontend environment
# URL of the rhob-backend service (Render: https://rhob-backend-xxxx.onrender.com ; local: http://localhost:8000)
API_BASE_URL=http://localhost:8000
# Long random string; signs the session cookie that holds the backend token server-side
FRONTEND_SESSION_SECRET=change-me-to-a-long-random-string
# Demo role used on first visit (viewer|operator|metallurgist|engineer|admin)
DEMO_DEFAULT_ACCOUNT=engineer
COOKIE_SECURE=false
API_TIMEOUT_S=180
PLANT_BRAND=INDUSTRY-X
